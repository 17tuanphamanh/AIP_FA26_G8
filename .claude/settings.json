{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(uv run pytest *)",
      "Bash(make lint)",
      "Bash(make test)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)"
    ],
    "ask": [
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(.venv/bin/pip install *)",
      "Bash(.venv/bin/python -m pip install *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(uv pip install *)",
      "Bash(uv add *)",
      "Bash(poetry add *)",
      "Bash(conda install *)",
      "Bash(*pip install *)",
      "Bash(*pip3 install *)",
      "Task",
      "Agent"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-test.sh",
            "timeout": 120,
            "statusMessage": "Chạy test trước khi commit…"
          }
        ]
      },
      {
        "matcher": "Read|Edit|Write|MultiEdit|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/chan-env.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
