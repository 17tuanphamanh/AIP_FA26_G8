{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest *)", "Bash(python3 -m pytest *)"
    ],
    "ask": [
      "Bash(pip install *)", "Bash(pip3 install *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-test.sh",
            "timeout": 120,
            "statusMessage": "Chạy test trước khi commit…"
          }
        ]
      }
    ]
  }
}
