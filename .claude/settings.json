{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(uv run pytest *)",
      "Bash(make lint)",
      "Bash(make test)"
    ],
    "ask": [
      "Bash(pip install *)",
      "Bash(pip3 install *)",
      "Bash(.venv/bin/pip install *)",
      "Bash(.venv/bin/python -m pip install *)",
      "Bash(python -m pip install *)",
      "Bash(python3 -m pip install *)",
      "Bash(uv pip install *)",
      "Bash(uv add *)",
      "Bash(poetry add *)",
      "Bash(conda install *)",
      "Bash(*pip install *)",
      "Bash(*pip3 install *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-commit-test.sh",
            "timeout": 120,
            "statusMessage": "Chạy test trước khi commit…"
          }
        ]
      }
    ]
  }
}
