# Mẫu cấu hình — docs/spec/build/01-kien-truc-project.md mục 5.1.
# Copy thành .env rồi điền giá trị thật. .env nằm trong .gitignore — KHÔNG BAO GIỜ commit.
# Lỡ commit key thì phải vào console nhà cung cấp revoke ngay, xoá dòng code không đủ.
# Không có .env thì `make up` dùng file này (in cảnh báo) — giá trị dưới đây CHỈ cho máy dev.

# ==== LLM (Phase 3d — P2, PLAN-3d Q-3d-3, Q-3d-13) ====
# BẮT BUỘC: scripted | real. Thiếu → mọi lệnh compose dừng, backend/worker từ chối khởi động.
#   scripted = ScriptedLLM (LLM giả, không gọi API) — CHỈ khi APP_ENV=dev|test; preset ở config/scripted/.
#   real     = provider thật (mốc G, decisions.md mục 4): cần FAST_MODEL, STRONG_MODEL (mỗi model PHẢI có dòng giá
#              trong `pricing` của config/llm.yaml, thiếu → từ chối khởi động), LLM_BASE_URL, LLM_API_KEY.
LLM_BACKEND=scripted
# FAST_MODEL=
# STRONG_MODEL=
# Q10: model riêng cho các bước hội thoại (B3, B10, B11); TRỐNG = dùng FAST_MODEL/STRONG_MODEL như cũ; bật demo: CHAT_MODEL=deepseek-v4-pro (cần dòng giá trong config/llm.yaml); B2 và B14 không bao giờ dùng biến này.
CHAT_MODEL=
# LLM_BASE_URL=
# LLM_SCRIPT_PRESET_DIR=               # mặc định <config>/scripted

# ==== Bí mật ====
# Khoá LLM để trống tới mốc G (docs/spec/build/decisions.md mục 4). Giá ở config/llm.yaml.
LLM_API_KEY=
# Sinh: python3 -c "import secrets;print(secrets.token_urlsafe(32))"   (HS256, >= 256 bit — P6)
JWT_SIGNING_KEY=
# Sinh: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"   (AES-256-GCM, 32 byte base64 — P6)
MFA_ENC_KEY=
# A2: JWT_SIGNING_KEY và MFA_ENC_KEY CHỈ container backend nhận — worker thấy một trong hai thì từ chối khởi động.
# Worker nhận khoá HMAC username ma = HMAC-SHA256(JWT_SIGNING_KEY, "auth-username-v1") dạng 64 hex — PHẢI đúng khoá backend đang dẫn xuất
# (đổi khoá là username ma của dữ liệu cũ băm khác). Sinh (ghi thẳng vào file mới NGOÀI repo, không in khoá ra màn hình), rồi tự chép
# dòng vào .env và xoá file:
#   PYTHONPATH=backend uv run python scripts/ops/derive_username_key.py --env-file .env --out "$TMPDIR/username_key.env"
# Thiếu → worker từ chối khởi động. Backend cũng nhận biến này để SO với khoá dẫn xuất từ JWT_SIGNING_KEY: lệch → route ticket/duyệt 503.
# Xoay JWT_SIGNING_KEY thì PHẢI tạo lại USERNAME_HMAC_KEY.
USERNAME_HMAC_KEY=
# Token dịch vụ (P6 mục 3, D-03) — mỗi token sinh riêng, >= 32 byte, KHÔNG dùng chung:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
# Mock kiểm ở header X-Service-Token; thiếu/ngắn/trùng nhau → mock trả 503 cho endpoint cần token.
# svc_agent: tool đọc (B6, B11) + đăng nhập qua AD.
SVC_AGENT_TOKEN=
# svc_executor: DUY NHẤT có quyền ghi (B17). Chỉ container backend nhận, worker không.
SVC_EXECUTOR_TOKEN=
# svc_worker: worker phát sự kiện timeout (Phase 2). Mock từ chối mọi lời gọi bằng token này.
SVC_WORKER_TOKEN=
# ml-service (Phase 3a, 3-Q21): BẮT BUỘC ở mọi môi trường — thiếu thì mọi lệnh compose dừng (kể cả make down)
# và backend/worker từ chối khởi động. Backend gửi ở header X-Service-Token. Sinh như token dịch vụ ở trên.
ML_SERVICE_TOKEN=
# Mật khẩu Postgres: superuser (chỉ script init dùng) và 3 role của P6 mục 6.
# Dùng chữ + số (hex) để không phải escape trong URL. Sinh: python3 -c "import secrets;print(secrets.token_hex(24))"
# LƯU Ý: script init chỉ chạy khi volume Postgres còn TRỐNG — đổi mật khẩu sau đó phải tạo lại volume (docker compose down -v).
PG_PASSWORD=dev-superuser-khong-dung-ngoai-may-dev
PG_MIGRATE_PASSWORD=dev-migrate
PG_RW_PASSWORD=dev-rw
PG_MONITOR_PASSWORD=dev-monitor

# ==== Hạ tầng ====
PG_SUPERUSER=postgres
PG_DATABASE=servicedesk
# Cổng host của postgres (chỉ cho công cụ chạy trên máy, backend dùng mạng nội bộ compose).
# Không dùng 5432 để khỏi đụng Postgres của dự án khác đang chạy trên máy dev.
PG_PORT=55432
# Chạy backend/Alembic trên máy (ngoài container). Trong compose, URL tự trỏ vào service `postgres`.
DATABASE_URL=postgresql+psycopg://app_rw:${PG_RW_PASSWORD}@localhost:${PG_PORT}/${PG_DATABASE}
MIGRATE_DATABASE_URL=postgresql+psycopg://app_migrate:${PG_MIGRATE_PASSWORD}@localhost:${PG_PORT}/${PG_DATABASE}
# M9 (role chỉ-đọc app_monitor). Để trống → dashboard/alerts trả 503 monitor_unavailable, KHÔNG rơi về app_rw.
MONITOR_DATABASE_URL=postgresql+psycopg://app_monitor:${PG_MONITOR_PASSWORD}@localhost:${PG_PORT}/${PG_DATABASE}
QDRANT_URL=http://localhost:6333
ML_SERVICE_URL=http://localhost:8200
MOCK_URL=http://localhost:8100
# Thư mục model của ml-service: mặc định ./models — đổi bằng biến make/shell (`make models up MODELS_DIR=…`),
# không đặt ở đây (Makefile export cho compose để kiểm, tải và mount cùng một chỗ).
# ml-service: ML_MAX_CONCURRENCY tự tính mặc định (ml_service/app/settings.py) — chỉ đặt khi cần đổi, KHÔNG để trống:
# ML_MAX_CONCURRENCY=1          # torch đã đa luồng; >1 trên 4 vCPU → các lô tranh CPU rồi cùng timeout
# ML_THREADS mặc định "4" TRONG compose (docker-compose.yml, Q-3a-16/S9 — tier ② đo trên CPU dev), không
# còn tự tính "vCPU − 1" của settings.py trừ khi gọi ml-service ngoài compose. Đặt lại nếu máy khác 4 luồng:
# ML_THREADS=4
# RAG ingest: RAG_KEEP_OLD_COLLECTIONS (mặc định 2 ở settings; không truyền qua compose) — số collection kb_* cũ giữ lại.
# RAG query (3c): RAG_PREFETCH_K, RAG_TOP_N, RAG_INTENT_FALLBACK, RAG_NEIGHBOR_WINDOW, RAG_EVIDENCE_MAX_TOKENS,
# RAG_QDRANT_TIMEOUT_S, RAG_DEADLINE_S — mặc định ở settings.py, không truyền qua compose.
# RAG_RERANK_K mặc định "10" TRONG compose (Q-3a-16/S9 — tier ②). Máy chậm hôm demo (p95 rerank không kịp
# TIMEOUT_S["rerank"]=18s) → đặt RAG_RERANK_K=5 ở đây để rerank ít đoạn hơn, không đổi code:
# RAG_RERANK_K=5
# Phase 5 (T23a, ML-GAN — D-44): model phân loại của nhóm (P11) — để trống/không đặt = không nạp, /classify và
# /classify_intent trả 503 như cũ.
# TEAM_MODELS_DIR: thư mục trên máy, mount read-only vào ml-service ở /ml_models (mặc định ./ml_models trong compose).
# TEAM_MODELS_DIR=/duong/dan/tuyet/doi/toi/ml_models
# GUARD_MODEL_DIR: đường dẫn TRONG container. Đặt mà thư mục thiếu file / có file .bin .pt .py / config.json không có
# nhãn INJECTION → ml-service từ chối khởi động.
# GUARD_MODEL_DIR=/ml_models/injection-clf/v3-seed123
# GUARD_MODEL_SHA256: SHA-256 của model.safetensors (không phải bí mật); đặt thì lệch → ml-service từ chối khởi động.
# GUARD_MODEL_SHA256=2d926f83df29cbdbc3637e22ecab893a1e6a0c2dc0f912315b3686a747108a02
# Phase 5 (gói 1, D-52): đặt GUARD_MODEL_DIR thì BẮT BUỘC cả GUARD_MODEL_SHA256 lẫn GUARD_MANIFEST_SHA256 (SHA-256 của file
# MANIFEST.sha256 trong thư mục model — sinh bằng `uv run python scripts/ml/make_manifest.py <thư mục>`, không phải bí mật);
# thiếu hoặc lệch → ml-service từ chối khởi động và cả stack đứng (backend chờ ml-service healthy). Thư mục phải nằm dưới
# /ml_models; manifest phải liệt kê đúng mọi file (không thừa, không thiếu, không symlink).
# GUARD_MANIFEST_SHA256=<sha256 của MANIFEST.sha256>
# Phase 5 (gói 2, D-53): model intent (intent-clf) — B3 CHỈ ghi điểm (model_probs, model_version), LLM vẫn quyết intent.
# INTENT_MODEL_DIR: đường dẫn TRONG container tới bản safetensors do `scripts/ml/convert_intent_pt.py` sinh (thư mục gốc có
# seed_42.pt KHÔNG nạp được — có file .pt/.bin/.py → từ chối khởi động). Đặt thì BẮT BUỘC cả INTENT_MODEL_SHA256 (SHA-256 của
# model.safetensors) lẫn INTENT_MANIFEST_SHA256 (SHA-256 của MANIFEST.sha256) — script chuyển in sẵn 2 dòng này; thiếu, lệch,
# sai tập file, sai inference_config (nhãn, tags, mix_weights[2] ≠ 0) hoặc thresholds.json → ml-service từ chối khởi động và cả
# stack đứng. Bộ nhớ: ml-service thêm ~1,2 GB RAM (trọng số fp32 ~1,1 GB) và ~10–25 s khởi động (SHA-256 + nạp). Điều kiện
# D-53: tổng các container ≤ 7 GB, không OOMKilled — máy 8 GB hoặc trượt điều kiện thì để trống (không nạp, /classify_intent 503).
# INTENT_MODEL_DIR=/ml_models/intent-clf/v3.1-seed42-st
# INTENT_MODEL_SHA256=<sha256 của model.safetensors>
# INTENT_MANIFEST_SHA256=<sha256 của MANIFEST.sha256>
# B2_CLASSIFIER_MODE (backend + worker): shadow (mặc định — model chặn tấn công chỉ chấm điểm, ghi vào nhật ký; câu
# không khớp mẫu luôn qua L4 LLM) | active (p ≥ 0,90 chặn, p ≤ 0,10 cho qua). Giá trị khác → từ chối khởi động.
# B2_CLASSIFIER_MODE=shadow
# Phase 5 (gói 1, D-52): thêm `review` — model nghi (p ≥ τ) mà LLM chấm nói không → chuyển L2 (E1 injection_suspected); model
# không bao giờ cho câu đi thẳng. `review` BẮT BUỘC B2_TAU_REVIEW ([0,50; 0,9999]); `active` chỉ nhận ở APP_ENV dev/test.
# Để trống tới khi chọn xong τ (scripts/eval/b2_tau_select.py).
# B2_TAU_REVIEW=
GRAPH_CONCURRENCY=8
LOCK_POOL_SIZE=10
# Hạn cho cả lượt (3f, phase3 9.0): TURN_BUDGET_S=100, SAFETY_MARGIN_S=2 — mặc định ở settings.py, không truyền qua
# compose. Phải SAFETY_MARGIN_S < TURN_BUDGET_S < WORKER_STALE_TURN_SECONDS (120), sai → backend/worker không khởi động.
TICKET_LOCK_TIMEOUT=5

# ==== Môi trường (Phase 2b-3) ====
# BẮT BUỘC (compose dừng nếu thiếu). dev | test | staging | prod. Thành phần GIẢ chỉ nạp khi dev/test:
# privacy guard không che (PRIVACY_GUARD=none) và người duyệt giả FAKE_APPROVER_ID (tới Phase 4) — môi trường
# khác thì backend/worker TỪ CHỐI khởi động (fail-closed, decisions.md 4.1 2b-Q2, 2b-Q3).
APP_ENV=dev
# Privacy guard (Phase 3 chặng 3e): mặc định MỌI môi trường là guard regex thật (che bí mật + PII trước khi lưu).
# Màn /console của mock (hiện mật khẩu tạm ở trang điện thoại giả lập): mặc định TẮT. Bật để demo: đúng 1 hoặc true — và chỉ
# có tác dụng khi APP_ENV là dev/test (môi trường khác vẫn 404).
# MOCK_CONSOLE_ENABLED=0
# PRIVACY_GUARD=none (không che) chỉ khi APP_ENV là dev/test — KHÔNG đặt trừ khi test cần. Mẫu ở config/privacy_patterns.json.
# PRIVACY_GUARD=regex
# Email thuộc các tên miền này (và tên miền con) KHÔNG bị che — cần cho slot. JSON list.
# COMPANY_EMAIL_DOMAINS=["congty-abc.vn"]
# Output guard (Phase 3 chặng 3g): chuỗi canary — chữ LLM sắp lưu/gửi người dùng chứa chuỗi này thì bị chặn. JSON list,
# mỗi chuỗi ≥ 8 ký tự; mặc định rỗng (test/probe đặt).
# OUTPUT_CANARIES=[]
# Người duyệt cố định của node B15 giả = user_id trong seed (l1_01 = ha.lt). Phải có dòng `users`:
# đăng nhập ha.lt MỘT lần trước khi có ticket cần duyệt, không thì ticket ra E9 (lỗi FK).
FAKE_APPROVER_ID=l1_01
# Kịch bản node giả trên stack (2b-4, `make gate2`), chỉ dev/test. FAKE_SCENARIO = preset cho ticket không
# gắn thẻ; ĐẶT biến này mới bật thẻ `[fake:<preset>]` trong câu yêu cầu (approval | clarify | confirm |
# raise | kill_b06 | kill_b15 — backend/app/graph/fakes.py). FAKE_NODE_DELAY = số giây dừng ở điểm do preset
# quyết (kill_b06, kill_b15) để SIGKILL giữa lượt; phải < WORKER_STALE_TURN_SECONDS / 2 (mặc định 120).
FAKE_SCENARIO=approval
FAKE_NODE_DELAY=40
# MAX_REQUEST_BODY_BYTES=65536         # > giới hạn → 413 trước mọi kiểm quyền
# BACKGROUND_SHUTDOWN_SECONDS=10       # tắt backend: chờ lượt nền bấy nhiêu giây rồi huỷ (worker phục hồi)
# on | off. Máy demo đặt off để tắt /docs, /redoc, /openapi.json (404). Giá trị khác → từ chối khởi động.
API_DOCS=on

# ==== Xác thực (P6) — có mặc định trong settings.py, chỉ đặt khi cần đổi ====
# MAX_AUTH_FAILURES và cửa sổ 10 phút là hằng số nghiệp vụ → config/policy.json, không đặt ở đây.
# Thiếu JWT_SIGNING_KEY hoặc SVC_AGENT_TOKEN → route /api/auth/* trả 503 (app vẫn chạy, /api/health vẫn OK).
# Manager bắt buộc MFA: đăng ký bằng `docker compose exec backend python -m app.auth.mfa enroll <username> --by <người vận hành> --reason <lý do>`.
# ACCESS_TTL_MINUTES=15
# REFRESH_TTL_HOURS=8
# LOCKOUT_MINUTES=15
# IP_FAILURE_LIMIT=20
# IP_FAILURE_WINDOW_MINUTES=10
# REAUTH_MINUTES=10
# REVOCATION_CACHE_SECONDS=30

# ==== Cờ thực nghiệm ====
EVAL_MODE=false
ENABLE_PROACTIVE_DIAGNOSIS=true
# D-76 (lô Q1+Q12): câu hỏi IT chung (máy in, Wi-Fi, Outlook…) trả lời từ KB general. false → như out_of_scope (E1), câu hỏi phân loại
# và tin E1 bỏ vế "hướng dẫn…". docker-compose.yml truyền biến này (mặc định true).
ENABLE_IT_HELP=true
# D-78 (lô Q13a): "Chưa ổn" + ghi chú sau câu trả lời KB → hỏi tiếp tối đa 2 vòng trong cùng ticket. false → E8 như trước lô.
ENABLE_KB_FOLLOWUP=true
# D-79 (lô Q13b): "Hỏi tiếp" sau khi ticket đã kết thúc (ticket mới mang gợi ý loại việc trước, không mang chữ cũ). false → tắt hẳn.
ENABLE_SESSION_MEMORY=true
# ENABLED_INTENTS mặc định ["vpn","account","software","access"] ở settings.py (3-Q27; T24 bật đủ 4; thiếu slot/PLAN/mẫu B18/người duyệt →
# không khởi động). docker-compose.yml KHÔNG truyền biến này vào container — stack luôn dùng mặc định; đặt ở đây chỉ có tác dụng ngoài compose.
STRATEGY=hybrid
LLM_CACHE_MODE=default
REDIAGNOSE_ON_NEW_SLOT=false

# ==== Phase 4 ====
# 4b P12: hạn duyệt rút ngắn (phút, 1–30) để thử hết hạn/nhắc trên stack — CHỈ khi APP_ENV là dev hoặc test (môi trường khác
# đặt biến này → backend/worker từ chối khởi động). Để trống = SLA_MINUTES (30) của config/policy.json.
APPROVAL_SLA_MINUTES_DEV=

# ==== Phase 5 (gói 2b) — chống spam (D-54 a) ====
# 429 theo tài khoản (sau đăng nhập): ticket mới ≤ TICKET_RATE_10MIN trong 10 phút và ≤ TICKET_RATE_HOUR mỗi giờ (không tính ticket con);
# /messages, /reply, /confirm chung một bộ ≤ MESSAGE_RATE_10MIN trong 10 phút. Để trống = mặc định settings.py (10 / 30 / 30).
# KHÔNG có giá trị "tắt" (số ≥ 1). Cổng, đo, harness, demo nới bằng số lớn: `make verify` tự truyền; chạy tay thì `make up RATE=loose`
# (không sửa ở đây) — ghi việc nới vào biên bản / manifest.
TICKET_RATE_10MIN=
TICKET_RATE_HOUR=
MESSAGE_RATE_10MIN=

# ==== SSE tiến trình ticket ====
# GET /api/tickets/{id}/events (thought/status/tool_call/token cho màn chat nhân viên). Tắt (mặc định) → route trả 404, frontend dùng polling.
ENABLE_SSE=false
SSE_POLL_MS=300
SSE_HEARTBEAT_S=15

# ==== Notify-email — backend ghi email_outbox, worker gửi qua SMTP ====
# Mặc định TẮT. Bật (EMAIL_ENABLED=true) thì BẮT BUỘC SMTP_HOST, SMTP_FROM, EMAIL_LINK_BASE_URL; SMTP_USERNAME và SMTP_PASSWORD đi cặp
# (đặt cả hai hoặc bỏ cả hai) — thiếu → backend và worker từ chối khởi động, thông báo nêu tên biến. Có tài khoản thì STARTTLS bắt buộc.
# EVAL_MODE=true → email luôn tắt (không ghi outbox, không gửi). Địa chỉ người nhận lấy từ users.email (đồng bộ từ AD lúc đăng nhập).
# Ví dụ Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587                      # STARTTLS (không dùng 465)
#   SMTP_STARTTLS=true
#   SMTP_USERNAME=tai-khoan-gui@gmail.com
#   SMTP_PASSWORD=<App Password 16 ký tự> # tạo ở Google Account → Security → App passwords; PHẢI bật xác minh 2 bước trước,
#                                      # không dùng mật khẩu đăng nhập Gmail. Chỉ đặt trong .env (gitignore), không commit.
#   SMTP_FROM=tai-khoan-gui@gmail.com  # PHẢI trùng tài khoản gửi (Gmail viết lại/đánh dấu thư nếu khác)
#   EMAIL_LINK_BASE_URL=http://localhost:5173   # gốc URL frontend cho dòng "Xem chi tiết: …" (không "/" cuối)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_LINK_BASE_URL=
# EMAIL_SEND_INTERVAL_SECONDS=15     # chu kỳ job send_emails của worker
