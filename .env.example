# Mẫu cấu hình — docs/spec/build/01-kien-truc-project.md mục 5.1.
# Copy thành .env rồi điền giá trị thật. .env nằm trong .gitignore — KHÔNG BAO GIỜ commit.
# Lỡ commit key thì phải vào console nhà cung cấp revoke ngay, xoá dòng code không đủ.
# Không có .env thì `make up` dùng file này (in cảnh báo) — giá trị dưới đây CHỈ cho máy dev.

# ==== Bí mật ====
# LLM để trống tới mốc G (docs/spec/build/decisions.md mục 4). Tên model/giá ở config/llm.yaml.
LLM_API_KEY=
# Sinh: python3 -c "import secrets;print(secrets.token_urlsafe(32))"   (HS256, >= 256 bit — P6)
JWT_SIGNING_KEY=
# Sinh: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"   (AES-256-GCM, 32 byte base64 — P6)
MFA_ENC_KEY=
# Sinh: python3 -c "import secrets;print(secrets.token_urlsafe(32))"   (token dịch vụ duy nhất có quyền ghi — D-03)
SVC_EXECUTOR_TOKEN=
# Mật khẩu Postgres: superuser (chỉ script init dùng) và 3 role của P6 mục 6.
# Dùng chữ + số (hex) để không phải escape trong URL. Sinh: python3 -c "import secrets;print(secrets.token_hex(24))"
# LƯU Ý: script init chỉ chạy khi volume Postgres còn TRỐNG — đổi mật khẩu sau đó phải tạo lại volume (docker compose down -v).
PG_PASSWORD=dev-superuser-khong-dung-ngoai-may-dev
PG_MIGRATE_PASSWORD=dev-migrate
PG_RW_PASSWORD=dev-rw
PG_MONITOR_PASSWORD=dev-monitor

# ==== Hạ tầng ====
PG_SUPERUSER=postgres
PG_DATABASE=servicedesk
# Cổng host của postgres (chỉ cho công cụ chạy trên máy, backend dùng mạng nội bộ compose).
# Không dùng 5432 để khỏi đụng Postgres của dự án khác đang chạy trên máy dev.
PG_PORT=55432
# Chạy backend/Alembic trên máy (ngoài container). Trong compose, URL tự trỏ vào service `postgres`.
DATABASE_URL=postgresql+psycopg://app_rw:${PG_RW_PASSWORD}@localhost:${PG_PORT}/${PG_DATABASE}
MIGRATE_DATABASE_URL=postgresql+psycopg://app_migrate:${PG_MIGRATE_PASSWORD}@localhost:${PG_PORT}/${PG_DATABASE}
QDRANT_URL=http://localhost:6333
ML_SERVICE_URL=http://localhost:8200
MOCK_URL=http://localhost:8100
GRAPH_CONCURRENCY=8
LOCK_POOL_SIZE=10
TICKET_LOCK_TIMEOUT=5

# ==== Cờ thực nghiệm ====
EVAL_MODE=false
ENABLE_PROACTIVE_DIAGNOSIS=true
STRATEGY=hybrid
LLM_CACHE_MODE=default
REDIAGNOSE_ON_NEW_SLOT=false
