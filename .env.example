# Copy file này thành .env rồi điền giá trị thật.
# .env nằm trong .gitignore — KHÔNG BAO GIỜ commit file .env.
# Lỡ commit key thì phải vào console nhà cung cấp revoke ngay, xoá dòng code không đủ.

ANTHROPIC_API_KEY=sk-ant-dien-key-cua-ban-vao-day

# Tuỳ chọn — đã có giá trị mặc định sẵn trong agent/config.py
MODEL=claude-opus-5
MAX_TOKENS=16000
MAX_STEPS=20
