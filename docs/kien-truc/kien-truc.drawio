/mxCell><mxCell id="trangthai_e21" value="E5, E7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;strokeColor=#B85450;fontColor=#990000;exitX=0.1;exitY=1;entryX=0.934;entryY=0;" edge="1" parent="1" source="st_S_EXECUTING" target="st_S_ESCALATED"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1436" y="440"/><mxPoint x="1275" y="440"/></Array></mxGeometry></mxCell><mxCell id="trangthai_e22" value="E8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;strokeColor=#B85450;fontColor=#990000;exitX=0;exitY=0.85;entryX=0.482;entryY=1;" edge="1" parent="1" source="st_S_CONFIRMING" target="st_S_ESCALATED"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1615" y="311"/><mxPoint x="1615" y="585"/><mxPoint x="900" y="585"/></Array></mxGeometry></mxCell><mxCell id="trangthai_e23" value="L2 xử lý xong (ngoài luồng agent)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;strokeColor=#2D7600;fontColor=#2D7600;dashed=1;exitX=0.2;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="st_S_ESCALATED" target="st_S_RESOLVED"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="666" y="625"/><mxPoint x="1730" y="625"/></Array></mxGeometry></mxCell><mxCell id="trangthai_e24" value="đã xác thực&lt;br&gt;(B01)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;strokeColor=#333333;" edge="1" parent="1" source="st_S_NEW" target="st_S_SCREENING"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="trangthai_e25" value="an toàn&lt;br&gt;(B02)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;strokeColor=#333333;" edge="1" parent="1" source="st_S_SCREENING" target="st_S_CLASSIFYING"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="trangthai_e26" value="intent hợp lệ&lt;br&gt;(B03–B05)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;strokeColor=#333333;" edge="1" parent="1" source="st_S_CLASSIFYING" target="st_S_DIAGNOSING"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="trangthai_e27" value="chẩn đoán&lt;br&gt;xong (B07)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;strokeColor=#333333;" edge="1" parent="1" source="st_S_DIAGNOSING" target="st_S_RETRIEVING"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="trangthai_e28" value="đủ thông tin&lt;br&gt;(B11)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;strokeColor=#333333;" edge="1" parent="1" source="st_S_RETRIEVING" target="st_S_ASSESSING"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="trangthai_e29" value="rủi ro thấp&lt;br&gt;(B13–B14)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;strokeColor=#333333;" edge="1" parent="1" source="st_S_ASSESSING" target="st_S_EXECUTING"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="trangthai_e30" value="thực thi&lt;br&gt;xong (B17)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;labelBackgroundColor=#FFFFFF;jumpStyle=arc;strokeColor=#333333;" edge="1" parent="1" source="st_S_EXECUTING" target="st_S_CONFIRMING"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="trangthai_v31" value="&lt;b&gt;Chú thích&lt;/b&gt; · &lt;font color=&quot;#1F4E99&quot;&gt;Xanh: đang xử lý (7)&lt;/font&gt; · &lt;font color=&quot;#B46504&quot;&gt;Cam: chờ người (3)&lt;/font&gt; · Viền đậm: kết thúc hoặc chuyển giao (4) · &lt;font color=&quot;#990000&quot;&gt;Mũi tên đỏ: lối thoát có mã E (E0–E9)&lt;/font&gt; · Trong ngoặc: bước gây ra chuyển&lt;br&gt;• Ngoài các mũi tên trên, mọi trạng thái chưa kết thúc đều có thể sang S_ESCALATED khi lỗi hệ thống (E2) hoặc lỗi chưa lường trước (E9) (D-29).&lt;br&gt;• Ticket cha của yêu cầu nhiều ý có thêm chuyển S_CLASSIFYING ↔ S_CONFIRMING khi gom kết quả các ticket con (D-29, D-31).&lt;br&gt;• Chuyển S_CLARIFYING → S_DIAGNOSING (chẩn đoán lại, D-20) có trong thiết kế nhưng đang tắt bằng cờ, nên không vẽ.&lt;br&gt;• Không ghi ngưỡng, thời hạn chờ hay nội dung luật. Nguồn: bảng chuyển trạng thái 2.1 + D-29 · &lt;i&gt;dev-tuananh @ 1a0145f, 27/10/2026&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="660" width="1780" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram>
</mxfile>
