{
  "name": "servicedesk-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "node scripts/dev-mock.mjs",
    "build": "vite build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "gen:api": "openapi-typescript http://127.0.0.1:8000/openapi.json -o src/api/schema.gen.ts",
    "check:dist": "vite build && node scripts/check-dist.mjs",
    "check:style": "node scripts/check-style.mjs",
    "test": "vitest run",
    "verify": "node scripts/verify.mjs",
    "e2e": "playwright test -c playwright.config.ts"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@microsoft/fetch-event-source": "2.0.1",
    "@tanstack/react-query": "5.104.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "happy-dom": "20.14.5",
    "msw": "3.0.0",
    "openapi-typescript": "7.13.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "msw": {
    "workerDirectory": [
      "dev-public"
    ]
  }
}
